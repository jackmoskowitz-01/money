# ─── Frontend (Vite) ───────────────────────────────────────
# Supabase project URL (public)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/publishable key (safe for frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...your-anon-key

# ─── Supabase Edge Functions ──────────────────────────────
# These are set in the Supabase dashboard under Edge Functions > Secrets

# Supabase internal (auto-provided in edge functions)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# LLM provider (used by deal-copilot, generate-outreach, smart-drafting, etc.)
# LOVABLE_API_KEY=

# Perplexity API (used by fetch-market-news, scan-company-news, enrich-prospect)
# PERPLEXITY_API_KEY=

# Google Places API (used by places-autocomplete, fetch-dc-buildings)
# GOOGLE_PLACES_API_KEY=

# Apify API (used by loopnet-search, apify-zoominfo-*)
# APIFY_API_KEY=

# ElevenLabs (used by copilot-tts, elevenlabs-scribe-token)
# ELEVENLABS_API_KEY=

# zoominfo-webhook: set WEBHOOK_SECRET and send x-webhook-secret on requests, OR for local/dev only:
# ALLOW_ZOOMINFO_WEBHOOK_WITHOUT_SECRET=true
# WEBHOOK_SECRET=

# Allowed origin for CORS (defaults to * if not set)
# ALLOWED_ORIGIN=https://your-app-domain.com
